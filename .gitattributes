# Git LFS tracking for large data files
# Track parquet data files with Git LFS
*.parquet filter=lfs diff=lfs merge=lfs -text

# Track large CSV files, but exclude small test golden files
*.csv filter=lfs diff=lfs merge=lfs -text
tests/data/golden/*.csv -filter -diff -merge

# Don't track cache files (they're in .gitignore anyway)
artifacts/data/cache/** -filter -diff -merge
